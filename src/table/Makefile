# Builds the symbol table module into a static library.

include ../../common.mk

TARGET := $(BUILD_DIR)/table/libtable.a

# init.cpp is intentionally not compiled yet: it needs the token constants
# generated by the parser, which is currently out of scope.
SRCS   := symbol.cpp variable.cpp table.cpp
OBJS   := $(SRCS:%.cpp=$(BUILD_DIR)/table/%.o)
DEPS   := $(OBJS:.o=.d)

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p $(dir $@)
	@printf "  AR      %s\n" "$@"
	@$(AR) rcs $@ $^

$(BUILD_DIR)/table/%.o: %.cpp
	@mkdir -p $(dir $@)
	@printf "  CXX     %s\n" "$<"
	@$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(DEPFLAGS) -c -o $@ $<

clean:
	@rm -rf $(BUILD_DIR)/table
	@printf "  CLEAN   %s\n" "$(BUILD_DIR)/table"

-include $(DEPS)
